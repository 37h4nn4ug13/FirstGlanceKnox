DEBUG=true
SECRET_KEY=replace-with-a-random-secret-before-use
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://127.0.0.1:8765
# Omit DATABASE_URL only for a single-process local SQLite preview.
# DATABASE_URL=postgresql://firstglance:change-me@127.0.0.1:5432/firstglance
# REDIS_URL=redis://127.0.0.1:6379/0
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
DEFAULT_FROM_EMAIL=FirstGlanceKnox <noreply@example.invalid>
BUSINESS_PHONE=
BUSINESS_EMAIL=
PAYMENT_INSTRUCTIONS=Contact FirstGlanceKnox to arrange payment. Include your invoice number.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
PUSH_ENABLED=false
EMAIL_TASKS_ENABLED=false
PORTAL_TOKEN_MAX_AGE=604800
# Set DEMO_PASSWORD locally or seed_demo generates one. Do not commit credentials.
# DEMO_PASSWORD=
# Optional production object storage:
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
